{
  "name": "bazziba-next",
  "version": "1.0.0",
  "description": "BAZZIBA! - Video platform for artists",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "tsc": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "format": "prettier --write .",
    "analyze": "ANALYZE=true next build",
    "prepare": "npm run tsc && npm run prisma:generate",
    "release": "npm run build && npm run test"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.5.3",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radicaljs/timeline": "^latest",
    "@supabase/supabase-js": "^2.49.10",
    "@uploadthing/react": "^7.3.3",
    "@vercel/kv": "^1.5.1",
    "@vercel/postgres": "^0.7.2",
    "algoliasearch": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "bun": "^1.2.21",
    "cloudflare": "^6.2.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.5",
    "framer-motion": "^12.9.3",
    "graphql-request": "^7.1.3",
    "hls.js": "^1.2.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.513.0",
    "next": "15.5.3",
    "next-auth": "^5.0.0-beta.10",
    "next-themes": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.55.2",
    "react-player": "^2.16.2",
    "sonner": "^2.1.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.4",
    "zod": "^3.25.41"
  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.11.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.2",
    "@next/mdx": "^46.1.8",
    "@playwright/test": "^1.52.8",
    "@types/eslint": "^9.58.12",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.2.0",
    "eslint-config-next": "15.5.3",
    "jest": "^29.7.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "prisma": "^6.11.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.x"
  }
}
